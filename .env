# Optiflows local env — generated 2026-04-15 for Ayrshare final-mile wiring.
# Do not commit. Keep on disk only.

# ── Ayrshare ─────────────────────────────────────────────────────────────────
# Primary API key. Grab from https://app.ayrshare.com/ → API Keys.
AYRSHARE_API_KEY=
# Optional. Only needed if you're on the Business plan with multiple profiles.
AYRSHARE_PROFILE_KEY=
AYRSHARE_BASE_URL=https://api.ayrshare.com/api

# Platforms to post to by default. Comma-separated.
# Start with linkedin alone for the first live test so nothing noisy goes out.
AYRSHARE_DEFAULT_PLATFORMS=linkedin

# Default post body. Leave blank to fall back to the manifest title.
AYRSHARE_DEFAULT_POST_TEXT=

# ── Public media hosting ─────────────────────────────────────────────────────
# Ayrshare needs publicly-reachable HTTPS URLs for every image/video it posts.
# Optiflows uses the GitHub Pages-served /social-assets/ folder.
# This value MUST point at the subfolder of the specific asset pack being posted.
# For the current carousel it's the path below. Switch it per pack, or use
# `npm run social:publish` which infers the per-target URL from OPTIFLOWS_SITE_BASE_URL.
OPTIFLOWS_PUBLIC_MEDIA_BASE_URL=https://optiflows.com.au/social-assets/optiflows-operating-system-carousel

# Site base used by publish-and-post.js when no per-call override is given.
# Use the apex (no www) to match the CNAME file — www.* 301-redirects to apex,
# so skipping that hop keeps media URLs clean for Ayrshare's fetcher.
OPTIFLOWS_SITE_BASE_URL=https://optiflows.com.au
