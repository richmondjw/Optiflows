{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "optiflows-private-content",
  "main": "private-content.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist-private",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "private.optiflows.com.au/*", "zone_name": "optiflows.com.au" },
    { "pattern": "proposals.optiflows.com.au/*", "zone_name": "optiflows.com.au" }
  ]
}
